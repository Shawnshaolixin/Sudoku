<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SudokuVerify</AssemblyName>
    <RootNamespace>SudokuVerify</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.cs 由 SDK 默认包含;这里只额外引入 Unity 工程里的 SudokuCore 源码 -->
    <Compile Include="..\Sudoku\Assets\Core\SudokuCore\*.cs" />
  </ItemGroup>
</Project>
